APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TrustTab
TRUSTTAB_DEMO_AUTH=false
# Shows the one-time code on the login page. Never enable in production.
TRUSTTAB_OTP_REVEAL=false
DISPLAY_CURRENCY=ZAR
DISPLAY_LOCALE=en_ZA

# MTN MoMo Collections. Never APP_URL. A URL-typed Cloud field often
# stores the app host or ttps:// (leading h dropped). Use a plain string.
#
# Sandbox:
#   MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
#   MOMO_TARGET_ENVIRONMENT=sandbox
#   MOMO_CURRENCY=EUR
# South Africa Collection:
#   MOMO_BASE_URL=https://proxy.momoapi.mtn.com
#   MOMO_TARGET_ENVIRONMENT=mtnsouthafrica
#   MOMO_CURRENCY=ZAR
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
# Sandbox only accepts EUR. mtnsouthafrica only accepts ZAR. This is
# not DISPLAY_CURRENCY; send this value to MoMo and persist it on the payment.
MOMO_CURRENCY=EUR
# Hostname only, no scheme or path, and it must match the host registered
# against the API user. A URL-typed Cloud field is stripped to the host.
# Leave empty to rely on payments:reconcile-pending.
MOMO_CALLBACK_HOST=
# Simulates MoMo locally when the sandbox is unreachable. Never enable in production.
MOMO_DEMO_MODE=false
